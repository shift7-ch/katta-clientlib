<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cloud.katta</groupId>
        <artifactId>katta-clientlib</artifactId>
        <version>1.0.4-SNAPSHOT</version>
    </parent>

    <artifactId>katta-clientlib-windows</artifactId>
    <!-- Produces Cloud.Katta.Clientlib.Windows.dll and a NuGet package, no jar -->
    <packaging>pom</packaging>

    <properties>
        <dotnet.configuration>Release</dotnet.configuration>
        <csharp.dir>${project.basedir}/src/main/csharp</csharp.dir>
        <libs.dir>${project.build.directory}/libs</libs.dir>
    </properties>

    <dependencies>
        <dependency>
            <groupId>cloud.katta</groupId>
            <artifactId>katta-clientlib-hub</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <!-- Resolved as .nupkg and unpacked to a NuGet fallback folder -->
            <groupId>ch.cyberduck</groupId>
            <artifactId>Cyberduck.Core</artifactId>
            <version>${cyberduck.version}</version>
            <type>nupkg</type>
        </dependency>
        <dependency>
            <groupId>ch.cyberduck</groupId>
            <artifactId>Cyberduck.Cryptomator</artifactId>
            <version>${cyberduck.version}</version>
            <type>nupkg</type>
        </dependency>
        <dependency>
            <groupId>ch.cyberduck</groupId>
            <artifactId>Cyberduck.Protocols</artifactId>
            <version>${cyberduck.version}</version>
            <type>nupkg</type>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- Provide hub as IKVM input and the Cyberduck packages to the .NET build -->
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-hub</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <!-- Dependencies are provided by the Cyberduck packages -->
                            <artifactItems>
                                <artifactItem>
                                    <groupId>cloud.katta</groupId>
                                    <artifactId>katta-clientlib-hub</artifactId>
                                    <version>${project.version}</version>
                                    <type>jar</type>
                                    <destFileName>katta-clientlib-hub.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${libs.dir}</outputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>resolve-nupkg</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>resolve</goal>
                        </goals>
                        <configuration>
                            <outputFile>${libs.dir}/nuget/packages.list</outputFile>
                            <outputAbsoluteArtifactFilename>true</outputAbsoluteArtifactFilename>
                            <includeTypes>nupkg</includeTypes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <executable>dotnet</executable>
                </configuration>
                <executions>
                    <execution>
                        <id>unpack-nupkg</id>
                        <phase>process-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>powershell.exe</executable>
                            <arguments>
                                <argument>-ExecutionPolicy</argument>
                                <argument>Bypass</argument>
                                <argument>-File</argument>
                                <argument>${project.basedir}/src/main/nuget/NuGet-Unpack.ps1</argument>
                                <argument>${libs.dir}/nuget/packages.list</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>dotnet-build</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>${csharp.dir}</workingDirectory>
                            <arguments>
                                <argument>build</argument>
                                <argument>-c</argument>
                                <argument>${dotnet.configuration}</argument>
                                <argument>-p:KattaVersion=${project.version}</argument>
                                <argument>-p:CyberduckVersion=${cyberduck.version}</argument>
                                <argument>-p:LibsDir=${libs.dir}</argument>
                                <argument>-p:RestoreAdditionalProjectFallbackFolders=${libs.dir}/nuget/packages</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>dotnet-test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${skipTests}</skip>
                            <workingDirectory>${project.basedir}/src/test/csharp</workingDirectory>
                            <arguments>
                                <argument>test</argument>
                                <argument>-c</argument>
                                <argument>${dotnet.configuration}</argument>
                                <argument>-p:KattaVersion=${project.version}</argument>
                                <argument>-p:CyberduckVersion=${cyberduck.version}</argument>
                                <argument>-p:LibsDir=${libs.dir}</argument>
                                <argument>-p:RestoreAdditionalProjectFallbackFolders=${libs.dir}/nuget/packages</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>dotnet-pack</id>
                        <phase>package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>${csharp.dir}</workingDirectory>
                            <arguments>
                                <argument>pack</argument>
                                <argument>-c</argument>
                                <argument>${dotnet.configuration}</argument>
                                <argument>-p:KattaVersion=${project.version}</argument>
                                <argument>-p:CyberduckVersion=${cyberduck.version}</argument>
                                <argument>-p:LibsDir=${libs.dir}</argument>
                                <argument>-p:RestoreAdditionalProjectFallbackFolders=${libs.dir}/nuget/packages</argument>
                                <argument>-o</argument>
                                <argument>${project.build.directory}/package</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>attach-nupkg</id>
                        <phase>package</phase>
                        <goals>
                            <goal>attach-artifact</goal>
                        </goals>
                        <configuration>
                            <artifacts>
                                <artifact>
                                    <type>nupkg</type>
                                    <file>${project.build.directory}/package/Cloud.Katta.Clientlib.Windows.${project.version}.nupkg</file>
                                </artifact>
                            </artifacts>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
