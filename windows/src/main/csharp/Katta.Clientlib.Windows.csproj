<Project Sdk="Microsoft.NET.Sdk">

  <!-- Copyright (c) 2026 shift7 GmbH. All rights reserved. -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Cloud.Katta.Clientlib.Windows</AssemblyName>
    <RootNamespace>Cloud.Katta</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version Condition="'$(KattaVersion)' != ''">$(KattaVersion)</Version>
    <PackageId>Cloud.Katta.Clientlib.Windows</PackageId>
    <Description>WPF implementation of DeviceSetupCallback for Katta Hub on Windows</Description>
    <Authors>shift7 GmbH</Authors>
    <CyberduckVersion Condition="'$(CyberduckVersion)' == ''">9.6.0</CyberduckVersion>
    <LibsDir Condition="'$(LibsDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\target\libs</LibsDir>
  </PropertyGroup>

  <!-- IKVM, same conventions as Cyberduck.java.props -->
  <PropertyGroup Label="IKVM">
    <ClassLoader>ikvm.runtime.AppDomainAssemblyClassLoader</ClassLoader>
    <DisableImplicitIkvmPackageReference>true</DisableImplicitIkvmPackageReference>
    <LangVersion>latest</LangVersion>
    <NoWarn>IKVM0100;IKVM0101;IKVM0105;IKVM0111;$(NoWarn)</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="IKVM" Version="8.16.1" />
    <PackageReference Include="Cyberduck.Core" Version="$(CyberduckVersion)" />
    <PackageReference Include="Cyberduck.Cryptomator" Version="$(CyberduckVersion)" />
  </ItemGroup>

  <!--
    Hub classes. Either reference an assembly already containing them (-p:HubAssembly=...), for example the one
    of the hosting application which provides the classes at runtime, or compile katta-clientlib-hub.jar copied
    by Maven to $(LibsDir). Compile time reference only, not distributed with this assembly.
  -->
  <ItemGroup Condition="'$(HubAssembly)' != ''">
    <Reference Include="$(HubAssembly)" />
  </ItemGroup>
  <ItemGroup Condition="'$(HubAssembly)' == ''">
    <ProjectReference Include="..\hub\Katta.Clientlib.Hub.ikvmproj" SetPlatform="Platform=AnyCPU" PrivateAssets="all" Private="false" />
  </ItemGroup>

</Project>
