<views:DialogWindow x:Class="Cloud.Katta.Views.DeviceSetupWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:Cloud.Katta.Views"
                    xmlns:katta="clr-namespace:Cloud.Katta"
                    Title="{x:Static katta:Strings.AuthorizationRequired}" MinWidth="420" MaxWidth="560">
    <StackPanel Margin="16">
        <TextBlock Text="{x:Static katta:Strings.AuthorizationRequired}" FontSize="16" FontWeight="SemiBold" />
        <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,8,0,12" />
        <!-- PasswordBox is not bindable, synchronized in code behind -->
        <PasswordBox x:Name="AccountKeyBox" PasswordChanged="OnAccountKeyChanged"
                     ToolTip="{x:Static katta:Strings.AccountKeyRequired}" AutomationProperties.Name="{x:Static katta:Strings.AccountKey}" />
        <TextBox Margin="0,8,0,0" Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="{x:Static katta:Strings.DeviceNameTooltip}" AutomationProperties.Name="{x:Static katta:Strings.DeviceName}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{x:Static katta:Strings.FinishSetup}" IsDefault="True" MinWidth="88" Margin="0,0,8,0"
                    IsEnabled="{Binding CanFinish}" Click="OnFinish" />
            <Button Content="{x:Static katta:Strings.Cancel}" IsCancel="True" MinWidth="88" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</views:DialogWindow>
