<views:DialogWindow x:Class="Cloud.Katta.Views.FirstLoginWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:Cloud.Katta.Views"
                    xmlns:katta="clr-namespace:Cloud.Katta"
                    Title="{x:Static katta:Strings.AccountKey}" MinWidth="420" MaxWidth="560">
    <StackPanel Margin="16">
        <TextBlock Text="{x:Static katta:Strings.AccountKey}" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="{x:Static katta:Strings.FirstLoginInfo}" TextWrapping="Wrap" Margin="0,8,0,12" />
        <TextBox Text="{Binding AccountKey, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="{x:Static katta:Strings.AccountKey}" />
        <Button Content="{x:Static katta:Strings.Copy}" HorizontalAlignment="Right" Margin="0,4,0,0" Padding="12,2" Click="OnCopy" />
        <TextBox x:Name="DeviceNameBox" Margin="0,12,0,0" Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="{x:Static katta:Strings.DeviceNameTooltip}" AutomationProperties.Name="{x:Static katta:Strings.DeviceName}" />
        <CheckBox Margin="0,12,0,0" IsChecked="{Binding Confirmed}" Content="{x:Static katta:Strings.StoredAccountKey}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{x:Static katta:Strings.FinishSetup}" IsDefault="True" MinWidth="88" Margin="0,0,8,0"
                    IsEnabled="{Binding CanFinish}" Click="OnFinish" />
            <Button Content="{x:Static katta:Strings.Cancel}" IsCancel="True" MinWidth="88" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</views:DialogWindow>
