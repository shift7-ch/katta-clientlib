<Project Sdk="IKVM.NET.Sdk">

  <!-- Copyright (c) 2026 shift7 GmbH. All rights reserved. -->

  <!--
    Compiles katta-clientlib-hub.jar only. Its dependencies are provided by the Cyberduck packages, referencing
    them resolves the Cyberduck types (Host, Controller, ...) and avoids duplicate classes (log4j, jackson, ...).
    Used to compile against. The hosting application provides the hub classes at runtime.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>katta-clientlib-hub</AssemblyName>
    <ClassLoader>ikvm.runtime.AppDomainAssemblyClassLoader</ClassLoader>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IsPackable>false</IsPackable>
    <CyberduckVersion Condition="'$(CyberduckVersion)' == ''">9.6.0</CyberduckVersion>
    <LibsDir Condition="'$(LibsDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\target\libs</LibsDir>
    <!-- Class Not Found, Class Format Error, Missing Class, NoClassDefFoundError. As in Cyberduck.java.props -->
    <NoWarn>IKVM0100;IKVM0101;IKVM0105;IKVM0111;$(NoWarn)</NoWarn>
    <AfterMicrosoftNETSdkTargets>$(MSBuildThisFileDirectory)Katta.Clientlib.Hub.After.targets;$(AfterMicrosoftNETSdkTargets)</AfterMicrosoftNETSdkTargets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cyberduck.Core" Version="$(CyberduckVersion)" />
    <PackageReference Include="Cyberduck.Cryptomator" Version="$(CyberduckVersion)" />
    <PackageReference Include="Cyberduck.Protocols" Version="$(CyberduckVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Convert Include="$(LibsDir)\katta-clientlib-hub.jar" />
  </ItemGroup>

</Project>
