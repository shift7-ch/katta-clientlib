# Variables of deploy/compose/hybrid derived from the env file of the tests (.chipotle.env), which Testcontainers passes as
# environment. Variables set in the environment take precedence over this file.
HUB_KEYCLOAK_PUBLIC_URL=${HUB_KEYCLOAK_URL}${HUB_KEYCLOAK_BASEPATH}
# the test license of HUB_INITIAL_LICENSE; deploy/compose/hybrid defaults to the production CA
HUB_LICENSE_CHAIN_REQUIRED_CN=Hub License Issuer CA (Test)
